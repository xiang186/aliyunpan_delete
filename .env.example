# ============================================================
# 阿里云盘重复文件清理工具 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# ---- 阿里云盘 OAuth 应用凭证 ----
# 在 https://open.alipan.com/ 创建应用后获取
ALIYUN_CLIENT_ID=your_client_id_here
ALIYUN_CLIENT_SECRET=your_client_secret_here

# ---- Token 加密密钥 ----
# 用于加密存储 Access Token 和 Refresh Token
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ---- 数据库配置 ----
# SQLite 数据库文件路径（相对于后端工作目录）
DATABASE_URL=sqlite:///./data/app.db

# ---- API 调用频率控制 ----
# 连续 API 调用之间的最小间隔（毫秒），默认 200ms
API_CALL_INTERVAL_MS=200

# ---- CORS 配置 ----
# 允许跨域请求的前端地址列表（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- OAuth 回调地址 ----
# 必须与阿里云盘应用配置中的回调地址一致
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
